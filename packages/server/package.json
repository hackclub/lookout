{
  "name": "@lookout/server",
  "version": "0.3.7",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx --env-file=../../.env drizzle-kit migrate",
    "tip": "tsx --env-file-if-exists=../../.env src/scripts/tip.ts",
    "versions": "tsx --env-file-if-exists=../../.env src/scripts/versions.ts",
    "nuke": "tsx --env-file-if-exists=../../.env src/scripts/nuke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@lookout/shared": "*",
    "@sentry/node": "^11.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
