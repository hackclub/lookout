{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/tags/tauri-v2.3.1/crates/tauri-utils/schema.json",
  "productName": "Lookout",
  "identifier": "com.hackclub.lookout",
  "version": "0.3.8",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Lookout",
        "width": 480,
        "minWidth": 480,
        "maxWidth": 480,
        "height": 640,
        "minHeight": 640,
        "maxHeight": 640,
        "resizable": false,
        "center": true,
        "fullscreen": false,
        "maximizable": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https: http://localhost:* ws://localhost:* ipc: tauri: lookout-preview: http://lookout-preview.localhost; img-src 'self' blob: data: https: lookout-preview: http://lookout-preview.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; media-src 'self' blob: https:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/lookout.desktop",
        "depends": [
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ],
        "recommends": [
          "gstreamer1.0-plugins-ugly"
        ]
      },
      "rpm": {
        "desktopTemplate": "./linux/lookout.desktop",
        "depends": [
          "pipewire-gstreamer",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ],
        "recommends": [
          "gstreamer1-plugin-openh264"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lookout"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OTY4MTcxNjk3N0YwQQpSV1FLZjVjV0YyaEpEQnZwVWpHVTBUSHdJcC9kZ09kRTJ6cVFZcFZVM0pqbGtwdHc2MjcwbC96Mwo=",
      "endpoints": [
        "https://github.com/hackclub/lookout/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
